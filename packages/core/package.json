{
  "name": "@getexp/core",
  "version": "0.1.0",
  "description": "GetExp shared building blocks: result, errors, logger, config, resilient http, idempotency.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./result": "./src/result.ts",
    "./errors": "./src/errors.ts",
    "./logger": "./src/logger.ts",
    "./config": "./src/config.ts",
    "./http": "./src/http.ts",
    "./idempotency": "./src/idempotency.ts",
    "./storage": "./src/storage.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
