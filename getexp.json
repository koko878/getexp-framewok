{
  "project": "getexp",
  "usageModel": "monorepo",
  "policy": "strict-with-per-app-override",
  "defaults": {
    "owner": "platform",
    "storage": {
      "relational": "postgres",
      "blob": "s3"
    }
  },
  "apps": [
    {
      "name": "reference-api-ts",
      "template": "api-ts"
    },
    {
      "name": "reference-api-py",
      "template": "api-py"
    },
    {
      "name": "expenses-api",
      "template": "api-ts"
    },
    {
      "name": "expenses-web",
      "template": "web"
    },
    {
      "name": "marketplace-api",
      "template": "api-ts"
    },
    {
      "name": "marketplace-mobile",
      "template": "mobile"
    }
  ]
}
